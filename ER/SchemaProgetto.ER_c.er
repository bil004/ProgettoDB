{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":151,"erCode":"/* Entities */\nentity PARCO {\n    Nome (id),\n    regione,\n    tipo,\n    superficie\n}\nentity ENTE {\n    CETS,\n    Nome (id)\n}\nentity ALBERGO {\n    indirizzo,\n    nome (id),\n    contatti,\n    servizi,\n    impiego_ecologico (optional),\n    trattamenti (optional, multi),\n    parcheggio (optional, multi),\n    CETS (optional)\n}\nentity TRAGITTI {\n    punto_partenza,\n    nome (id),\n    difficolta,\n    durata\n}\nentity PIEDI\nentity BICI\nentity CAVALLO\nentity UTENTE {\n    password,\n    Username (id)\n}\nentity GUIDA {\n    COD (id),\n    cognome,\n    nome,\n    data_nascita,\n    campo,\n    licenza\n}\nentity SENIOR\nentity BAMBINO\nentity GRUPPO {\n    tipo,\n    ID (id),\n    totPartecipanti\n}\nentity FEEDBACK {\n    data (external),\n    valutazione,\n    ora (external),\n    commento\n}\nentity ZONE_UMIDE\nentity TERRESTRI_E_MARINE\nentity RISERVA\nentity NATURALE\nentity TOUR {\n    nome (id),\n    maxPartecipanti,\n    stato\n}\nentity CALENDARIO {\n    idCalendario (id),\n    data,\n    oraInizio,\n    oraFine\n}\n\n/* Relationships */\nrelationship GESTITO_DA (\n    PARCO: zero..many,\n    ENTE: zero..many\n)\nrelationship RISTORA_IN (\n    UTENTE: zero..one,\n    ALBERGO: one..one\n) {\n    dataPrenotazione,\n    numStanze\n}\nrelationship SVOLGE (\n    GUIDA: one..many,\n    TRAGITTI: one..many\n)\nrelationship VISITA (\n    PARCO: zero..many,\n    UTENTE: zero..many\n) {\n    data,\n    oraEntrata,\n    oraUscita\n}\nrelationship APPARTIENE_A (\n    UTENTE: zero..many,\n    GRUPPO: zero..many\n)\nrelationship ESPRIME (\n    FEEDBACK: zero..one,\n    UTENTE: zero..many\n)\nrelationship RIGUARDO (\n    FEEDBACK: one..one external,\n    TRAGITTI: zero..many\n)\nrelationship ASSEGNATO_ALLA (\n    GUIDA: zero..many,\n    FEEDBACK: zero..many\n) {\n    voto\n}\nrelationship PRENOTA (\n    GUIDA: one..many,\n    UTENTE: zero..one\n) {\n    orari,\n    giorniDisponibili,\n    disponibile,\n    stato\n}\nrelationship ASSEGNATA_A (\n    GUIDA: zero..many,\n    TOUR: one..many\n)\nrelationship INCLUDE (\n    TOUR: one..many,\n    TRAGITTI: zero..many\n)\nrelationship DISPONIBILE (\n    CALENDARIO: one..one,\n    GUIDA: one..many\n)\n\n/* Generalizations */\nTRAGITTI <= {\n    CAVALLO,\n    PIEDI,\n    BICI\n} (total, exclusive)\nUTENTE <= {\n    SENIOR,\n    BAMBINO\n} (partial, exclusive)\nPARCO <= {\n    NATURALE,\n    RISERVA,\n    ZONE_UMIDE,\n    TERRESTRI_E_MARINE\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"PARCO","_x":-545,"_y":-252,"_mag":false},{"__type":"Attribute","_id":2,"_name":"Nome","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-126,"_y":-39},{"__type":"Attribute","_id":4,"_name":"regione","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-127,"_y":6},{"__type":"Entity","_id":6,"_name":"ENTE","_x":26,"_y":-256,"_mag":false},{"__type":"Attribute","_id":7,"_name":"CETS","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":6,"_x":124,"_y":15},{"__type":"Attribute","_id":8,"_name":"Nome","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":6,"_x":128,"_y":-17},{"__type":"Relationship","_id":10,"_name":"GESTITO_DA","_x":-247,"_y":-254},{"__type":"Participation","_id":11,"_entityId":1,"_tableId":null,"_relationshipId":10,"_cardinality":"0_N","_externalIdentifier":false,"_role":""},{"__type":"Participation","_id":12,"_entityId":6,"_tableId":null,"_relationshipId":10,"_cardinality":"0_N","_externalIdentifier":false,"_role":""},{"__type":"Attribute","_id":21,"_name":"tipo","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-116,"_y":-78},{"__type":"Entity","_id":22,"_name":"ALBERGO","_x