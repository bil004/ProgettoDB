:"Attribute","_id":159,"_name":"ora","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":50,"_x":-90,"_y":84}},"sqlLinearCode":""},"edited":true,"sceneResetToken":1747126871318,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showRenamingRoleInput":false,"showMultivalueAttributeMenu":false,"showCompositeAttributeMenu":false,"showGeneralizationMenu":false,"showExportMenu":false,"showNotes":false},"erTranslation":{"model":{"uid":304,"erCode":"/* Entities */\nentity PARCO {\n    Nome (id),\n    regione,\n    tipo,\n    superficie\n}\nentity ENTE {\n    CETS,\n    Nome (id)\n}\nentity ALBERGO {\n    indirizzo,\n    nome (id),\n    contatti,\n    servizi,\n    impiego_ecologico (optional),\n    trattamenti (optional, multi),\n    parcheggio,\n    CETS (optional)\n}\nentity TRAGITTI {\n    punto_partenza,\n    nome (id),\n    difficolta,\n    durata\n}\nentity PIEDI\nentity BICI\nentity CAVALLO\nentity UTENTE {\n    password,\n    Username (id)\n}\nentity GUIDA {\n    COD (id),\n    cognome,\n    nome,\n    data_nascita,\n    campo,\n    licenza\n}\nentity SENIOR\nentity BAMBINO\nentity GRUPPO {\n    tipo,\n    ID (id),\n    totPartecipanti\n}\nentity FEEDBACK {\n    data (external),\n    valutazione,\n    ora (external),\n    commento\n}\nentity ZONE_UMIDE\nentity TERRESTRI_E_MARINE\nentity RISERVA\nentity NATURALE\nentity TOUR {\n    nome (id),\n    maxPartecipanti,\n    stato\n}\nentity CALENDARIO {\n    idCalendario (id),\n    data,\n    oraInizio,\n    oraFine\n}\n\n/* Relationships */\nrelationship GESTITO_DA (\n    PARCO: zero..many,\n    ENTE: zero..many\n)\nrelationship RISTORA_IN (\n    UTENTE: zero..one,\n    ALBERGO: one..one\n) {\n    dataPrenotazione,\n    numStanze\n}\nrelationship SVOLGE (\n    GUIDA: one..many,\n    TRAGITTI: one..many\n)\nrelationship VISITA (\n    PARCO: zero..many,\n    UTENTE: zero..many\n) {\n    data,\n    oraEntrata,\n    oraUscita\n}\nrelationship APPARTIENE_A (\n    UTENTE: zero..many,\n    GRUPPO: zero..many\n)\nrelationship ESPRIME (\n    FEEDBACK: zero..one,\n    UTENTE: zero..many\n)\nrelationship RIGUARDO (\n    FEEDBACK: one..one external,\n    TRAGITTI: zero..many\n)\nrelationship ASSEGNATO_ALLA (\n    GUIDA: zero..many,\n    FEEDBACK: zero..many\n) {\n    voto\n}\nrelationship PRENOTA (\n    GUIDA: one..many,\n    UTENTE: zero..one\n) {\n    orari,\n    giorniDisponibili,\n    disponibile,\n    stato\n}\nrelationship ASSEGNATA_A (\n    GUIDA: zero..many,\n    TOUR: one..many\n)\nrelationship INCLUDE (\n    TOUR: one..many,\n    TRAGITTI: zero..many\n)\nrelationship DISPONIBILE (\n    CALENDARIO: one..one,\n    GUIDA: one..many\n)\n\n/* Generalizations */\nTRAGITTI <= {\n    CAVALLO,\n    PIEDI,\n    BICI\n} (total, exclusive)\nUTENTE <= {\n    SENIOR,\n    BAMBINO\n} (partial, exclusive)\nPARCO <= {\n    NATURALE,\n    RISERVA,\n    ZONE_UMIDE,\n    TERRESTRI_E_MARINE\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Table","_id":159,"_name":"GUIDA","_x":-1145,"_y":123,"_mag":false},{"__type":"Column","_id":165,"_name":"COD","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":159,"_tableIndex":0},{"__type":"Column","_id":166,"_name":"cognome","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":159,"_tableIndex":1},{"__type":"Column","_id":167,"_name":"nome","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":159,"_tableIndex":2},{"__type":"Column","_id":168,"_name":"data_nascita","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":159,"_tableIndex":3},{"__type":"Column","_id":169,"_name":"campo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":159,"_tableIndex":4},{"__type":"Column","_id":170,"_name":"licenza","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":159,"_tableIndex":5},{"__type":"Table","_id":171,"_name"