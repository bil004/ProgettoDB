coration: underline;\">CAP</u>, nome, contatti, servizi, impiego_ecologico*, trattamenti, parcheggio, CETS*)<br><br>\nTRAGITTI (<u  style=\"text-decoration: underline;\">nomeTragitto</u>, punto_partenza, difficolta, durata, descrizione, Type)<br><br>\nPERSONA (<u  style=\"text-decoration: underline;\">COD_fiscale</u>, nome, cognome, dataNascita, Type)<br><br>\nTOUR (<u  style=\"text-decoration: underline;\">nomeTour</u>, maxPartecipanti, stato, data, ora)<br><br>\nGRUPPO (<u  style=\"text-decoration: underline;\">nomeGruppo</u>, tipo, totPartecipanti, classe*)<br><br>\nGUIDA (<u  style=\"text-decoration: underline;\">numTesserino</u>, voto, licenza, campo)<br><br>\nCENTRO_VISITA (<u  style=\"text-decoration: underline;\">nomeCentro</u>, indirizzo, orarioApertura, servizi, note, orarioChiusura, telefono, email)<br><br>\nUTENTE (<u  style=\"text-decoration: underline;\">username</u>, password, email, telefono, PERSONA_COD_fiscale)<br><br>\nNEWS (<u  style=\"text-decoration: underline;\">data</u>, <u  style=\"text-decoration: underline;\">titolo</u>, autore, testo, foto, PARCO_nomeParco)<br><br>\nFEEDBACK (<u  style=\"text-decoration: underline;\">TRAGITTI_nomeTragitto</u>, <u  style=\"text-decoration: underline;\">data</u>, <u  style=\"text-decoration: underline;\">ora</u>, valutazione, commento, tipo, UTENTE_username*, anonimo*)<br><br>\nCALENDARIO (<u  style=\"text-decoration: underline;\">GUIDA_numTesserino</u>, <u  style=\"text-decoration: underline;\">data</u>, <u  style=\"text-decoration: underline;\">oraInizio</u>, <u  style=\"text-decoration: underline;\">oraFine</u>, note)<br><br>\nGESTIONE (<u  style=\"text-decoration: underline;\">PARCO_nomeParco</u>, <u  style=\"text-decoration: underline;\">ENTE_nomeEnte</u>)<br><br>\nRISERVARE (<u  style=\"text-decoration: underline;\">STRUTTURA_RICETTIVA_Via</u>, <u  style=\"text-decoration: underline;\">STRUTTURA_RICETTIVA_numCivico</u>, <u  style=\"text-decoration: underline;\">STRUTTURA_RICETTIVA_CAP</u>, <u  style=\"text-decoration: underline;\">PERSONA_COD_fiscale</u>, dataPrenotazione, numStanze, stato)<br><br>\nINCLUDE (<u  style=\"text-decoration: underline;\">TRAGITTI_nomeTragitto</u>, <u  style=\"text-decoration: underline;\">TOUR_nomeTour</u>)<br><br>\nVISITA (<u  style=\"text-decoration: underline;\">PARCO_nomeParco</u>, <u  style=\"text-decoration: underline;\">PERSONA_COD_fiscale</u>, data, oraEntrata, oraUscita)<br><br>\nAPPARTIENE_A (<u  style=\"text-decoration: underline;\">PERSONA_COD_fiscale</u>, <u  style=\"text-decoration: underline;\">GRUPPO_nomeGruppo</u>)<br><br>\nPRENOTA (<u  style=\"text-decoration: underline;\">TOUR_nomeTour</u>, <u  style=\"text-decoration: underline;\">UTENTE_username</u>, orario, giorniDisponibili, disponibile, stato, data)<br><br>\nASSEGNATA_A (<u  style=\"text-decoration: underline;\">TOUR_nomeTour</u>, <u  style=\"text-decoration: underline;\">GUIDA_numTesserino</u>)<br><br>\nSVOLGE (<u  style=\"text-decoration: underline;\">TRAGITTI_nomeTragitto</u>, <u  style=\"text-decoration: underline;\">GUIDA_numTesserino</u>)<br><br>\nSI_RIVOLGE_A (<u  style=\"text-decoration: underline;\">PERSONA_COD_fiscale</u>, <u  style=\"text-decoration: underline;\">CENTRO_VISITA_nomeCentro</u>)<br><br>\nSI_RIFERISCE_A (<u  style=\"text-decoration: underline;\">PARCO_nomeParco</u>, <u  style=\"text-decoration: underline;\">CENTRO_VISITA_nomeCentro</u>)<br><br>\nRELATIVO_A (<u  style=\"text-decoration: underline;\">GUIDA_numTesserino</u>, <u  style=\"text-decoration: underline;\">FEEDBACK_TRAGITTI_nomeTragitto</u>, <u  style=\"text-decoration: underline;\">FEEDBACK_data</u>, <u  style=\"text-decoration: underline;\">FEEDBACK_ora</u>)<br><br>\n\n<br><h3>Referential integrity constraints</h3>\n\n\n\n\n\n\n\n\nUTENTE (PERSONA_COD_fiscale)  REFERENCES PERSONA  (COD_fiscale)<br><br>\nNEWS (PARCO_nomeParco)  REFERENCES PARCO  (nomeParco)<br><br>\nFEEDBACK (TRAGITTI_nomeTragitto)  REFERENCES TRAGITTI  (nomeTragitto)<br><br>FEEDBACK (UTENTE_username)  REFERENCES UTENTE  (username)<br><br>\nCALENDARIO (GUIDA_numTesserino)  REFERENCES GUIDA  (numTesserino)<br><br>\nGESTIONE (PARCO_nomeParco)  REFERENCES PARCO  (nomeParco)<br><br>GESTIONE (ENTE_nomeEnte)  REFERENCES ENTE  (nomeEnte)<br><br>\nRISERVARE (STRUTTURA_RICETTIVA_Via, STRUTTURA_RICETTIVA_numCivico, STRUTTURA_RICETTIVA_CAP)  REFERENCES STRUTTURA_RICETTIVA  (Via, numCivico, CAP)<br><br>RISERVARE (PERSONA_COD_fiscale)  REFERENCES PERSONA  (COD_fiscale)<br><br>\nINCLUDE (TRAGITTI_nomeTragitto)  REFERENCES TRAGITTI  (nomeTragitto)<br><br>INCLUDE (TOUR_nomeTour)  REFERENCES TOUR  (nomeTour)<br><br>\nVISITA (PARCO_nomeParco)  REFERENCES PARCO  (nomeParco)<br><br>VISITA (PERSONA_COD_fiscale)  REFERENCES PERSONA  (COD_fiscale)<br><br>\nAPPARTIENE_A (PERSONA_COD_fiscale)  REFERENCES PERSONA  (COD_fiscale)<br><br>APPARTIENE_A (GRUPPO_nomeGruppo)  REFERENCES GRUPPO  (nomeGruppo)<br><br>\nPRENOTA (TOUR_nomeTour)  REFERENCES TOUR  (nomeTour)<br><br>PRENOTA (UTENTE_username)  REFERENCES UTENTE  (username)<br><br>\nASSEGNATA_A (TOUR_nomeTour)  REFERENCES TOUR  (nomeTour)<br><br>ASSEGNATA_A (GUIDA_numTesserino)  REFERENCES GUIDA  (numTesserino)<br><br>\nSVOLGE (TRAGITTI_nomeTragitto)  REFERENCES TRAGITTI  (nomeTragitto)<br><br>SVOLGE (GUIDA_numTesserino)  REFERENCES GUIDA  (numTesserino)<br><br>\nSI_RIVOLGE_A (PERSONA_COD_fiscale)  REFERENCES PERSONA  (COD_fiscale)<br><br>SI_RIVOLGE_A (CENTRO_VISITA_nomeCentro)  REFERENCES CENTRO_VISITA  (nomeCentro)<br><br>\nSI_RIFERISCE_A (PARCO_nomeParco)  REFERENCES PARCO  (nomeParco)<br><br>SI_RIFERISCE_A (CENTRO_VISITA_nomeCentro)  REFERENCES CENTRO_VISITA  (nomeCentro)<br><br>\nRELATIVO_A (GUIDA_numTesserino)  REFERENCES GUIDA  (numTesserino)<br><br>RELATIVO_A (FEEDBACK_TRAGITTI_nomeTragitto, FEEDBACK_data, FEEDBACK_ora)  REFERENCES FEEDBACK  (TRAGITTI_nomeTragitto, data, ora)<br><br>"},"edited":true,"sceneResetToken":1760365868372,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":null,"showNotesDataMenu":false}