1","_externalIdentifier":false,"_role":""},"333":{"__type":"Column","_id":333,"_name":"data","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":331,"_tableIndex":0},"334":{"__type":"Column","_id":334,"_name":"titolo","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":331,"_tableIndex":1},"335":{"__type":"Column","_id":335,"_name":"autore","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":331,"_tableIndex":2},"336":{"__type":"Column","_id":336,"_name":"testo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":331,"_tableIndex":3},"337":{"__type":"Column","_id":337,"_name":"foto","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":331,"_tableIndex":4}},"sqlLinearCode":""},"edited":true,"sceneResetToken":1759843448991,"selectedItemId":50,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showOneToManyTypeBRelationshipMenu":false,"showOneToOneTypeBRelationshipMenu":false,"showOneToOneTypeCRelationshipMenu":false,"showExportMenu":false,"showNotes":false},"schemaDesign":{"model":{"uid":304,"erCode":"/* Entities */\nentity PARCO {\n    Nome (id),\n    regione,\n    tipo,\n    superficie\n}\nentity ENTE {\n    CETS,\n    Nome (id)\n}\nentity ALBERGO {\n    indirizzo,\n    nome (id),\n    contatti,\n    servizi,\n    impiego_ecologico (optional),\n    trattamenti (optional, multi),\n    parcheggio,\n    CETS (optional)\n}\nentity TRAGITTI {\n    punto_partenza,\n    nome (id),\n    difficolta,\n    durata\n}\nentity PIEDI\nentity BICI\nentity CAVALLO\nentity UTENTE {\n    password,\n    Username (id)\n}\nentity GUIDA {\n    COD (id),\n    cognome,\n    nome,\n    data_nascita,\n    campo,\n    licenza\n}\nentity SENIOR\nentity BAMBINO\nentity GRUPPO {\n    tipo,\n    ID (id),\n    totPartecipanti\n}\nentity FEEDBACK {\n    data (external),\n    valutazione,\n    ora (external),\n    commento\n}\nentity ZONE_UMIDE\nentity TERRESTRI_E_MARINE\nentity RISERVA\nentity NATURALE\nentity TOUR {\n    nome (id),\n    maxPartecipanti,\n    stato\n}\nentity CALENDARIO {\n    idCalendario (id),\n    data,\n    oraInizio,\n    oraFine\n}\n\n/* Relationships */\nrelationship GESTITO_DA (\n    PARCO: zero..many,\n    ENTE: zero..many\n)\nrelationship RISTORA_IN (\n    UTENTE: zero..one,\n    ALBERGO: one..one\n) {\n    dataPrenotazione,\n    numStanze\n}\nrelationship SVOLGE (\n    GUIDA: one..many,\n    TRAGITTI: one..many\n)\nrelationship VISITA (\n    PARCO: zero..many,\n    UTENTE: zero..many\n) {\n    data,\n    oraEntrata,\n    oraUscita\n}\nrelationship APPARTIENE_A (\n    UTENTE: zero..many,\n    GRUPPO: zero..many\n)\nrelationship ESPRIME (\n    FEEDBACK: zero..one,\n    UTENTE: zero..many\n)\nrelationship RIGUARDO (\n    FEEDBACK: one..one external,\n    TRAGITTI: zero..many\n)\nrelationship ASSEGNATO_ALLA (\n    GUIDA: zero..many,\n    FEEDBACK: zero..many\n) {\n    voto\n}\nrelationship PRENOTA (\n    GUIDA: one..many,\n    UTENTE: zero..one\n) {\n    orari,\n    giorniDisponibili,\n    disponibile,\n    stato\n}\nrelationship ASSEGNATA_A (\n    GUIDA: zero..many,\n    TOUR: one..many\n)\nrelationship INCLUDE (\n    TOUR: one..many,\n    TRAGITTI: zero..many\n)\nrelationship DISPONIBILE (\n    CALENDARIO: one..one,\n    GUIDA: one..many\n)\n\n/* Generalizations */\nTRAGITTI <= {\n    CAVALLO,\n    PIEDI,\n    BICI\n} (total, exclusive)\nUTENTE <= {\n    SENIOR,\n    BAMBINO\n} (partial, exclusive)\nPARCO <= {\n    NATURALE,\n    RISERVA,\n    ZONE_UMIDE,\n    TERRESTRI_E_MARINE\n} (partial, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE GUIDA (\n    COD INTEGER NOT NULL,\n    cognome INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    data_nascita INTEGER NOT NULL,\n    campo INTEGER NOT NULL,\n    licenza INTEGER NOT NULL,\n    PRIMARY KEY (COD)\n);\nCREATE TABLE TOUR (\n    nome INTEGER NOT NULL,\n    maxPartecipanti INTEGER NOT NULL,\n    stato INTEGER NOT NULL,\n    PRIMARY KEY (nome)\n);\nCREATE TABLE TRAGITTI (\n    nome INTEGER NOT NULL,\n    punto_partenza INTEGER NOT NULL,\n    difficolta INTEGER NOT NULL,\n    durata INTEGER NOT NULL,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (nome)\n);\nCREATE TABLE PARCO (\n    Nome INTEGER NOT NULL,\n    regione INTEGER NOT NULL,\n    tipo INTEGER NOT NULL,\n    superficie INTEGER NOT NULL,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (Nome)\n);\nCREATE TABLE UTENTE (\n    Username INTEGER NOT NULL,\n    password INTEGER NOT NULL,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (Username)\n);\nCREATE TABLE ENTE (\n    Nome INTEGER NOT NULL,\n    CETS INTEGER NOT NULL,\n    PRIMARY KEY (Nome)\n);\nCREATE TABLE GRUPPO (\n    ID INTEGER NOT NULL,\n    tipo INTEGER NOT NULL,\n    totPartecipanti INTEGER NOT NULL,\n    PRIMARY KEY (ID)\n);\nCREATE TABLE CALENDARIO (\n    idCalendario INTEGER NOT NULL,\n    data INTEGER NOT NULL,\n    oraInizio INTEGER NOT NULL,\n    oraFine INTEGER NOT NULL,\n    GUIDA_COD INTEGER NOT NULL,\n    PRIMARY KEY (idCalendario),\n    FOREIGN KEY (GUIDA_COD) REFERENCES GUIDA (COD)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE FEEDBACK (\n    TRAGITTI_nome INTEGER NOT NULL,\n    data INTEGER NOT NULL,\n    ora INTEGER NOT NULL,\n    valutazione INTEGER NOT NULL,\n    commento INTEGER NOT NULL,\n    UTENTE_Username INTEGER,\n    PRIMARY KEY (TRAGITTI_nome, data, ora),\n    FOREIGN KEY (TRAGITTI_nome) REFERENCES TRAGITTI (nome)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (UTENTE_Username) REFERENCES UTENTE (Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE ALBERGO (\n    nome INTEGER NOT NULL,\n    indirizzo INTEGER NOT NULL,\n    contatti INTEGER NOT NULL,\n    servizi INTEGER NOT NULL,\n    impiego_ecologico INTEGER,\n    parcheggio INTEGER NOT NULL,\n    CETS INTEGER,\n    UTENTE_Username INTEGER NOT NULL,\n    dataPrenotazione INTEGER NOT NULL,\n    numStanze INTEGER NOT NULL,\n    PRIMARY KEY (nome),\n    FOREIGN KEY (UTENTE_Username) REFERENCES UTENTE (Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE HAS_TRATTAMENTI (\n    ALBERGO_nome INTEGER NOT NULL,\n    TRATTAMENTI_trattamenti INTEGER NOT NULL,\n    PRIMARY KEY (ALBERGO_nome, TRATTAMENTI_trattamenti),\n    FOREIGN KEY (ALBERGO_nome) REFERENCES ALBERGO (nome)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE APPARTIENE_A (\n    UTENTE_Username INTEGER NOT NULL,\n    GRUPPO_ID INTEGER NOT NULL,\n    PRIMARY KEY (UTENTE_Username, GRUPPO_ID),\n    FOREIGN KEY (UTENTE_Username) REFERENCES UTENTE (Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (GRUPPO_ID) REFERENCES GRUPPO (ID)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE ASSEGNATO_ALLA (\n    GUIDA_COD INTEGER NOT NULL,\n    FEEDBACK_TRAGITTI_nome INTEGER NOT NULL,\n    FEEDBACK_data INTEGER NOT NULL,\n    FEEDBACK_ora INTEGER NOT NULL,\n    voto INTEGER NOT NULL,\n    PRIMARY KEY (GUIDA_COD, FEEDBACK_TRAGITTI_nome, FEEDBACK_data, FEEDBACK_ora),\n    FOREIGN KEY (GUIDA_COD) REFERENCES GUIDA (COD)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (FEEDBACK_TRAGITTI_nome, FEEDBACK_data, FEEDBACK_ora) REFERENCES FEEDBACK (TRAGITTI_nome, data, ora)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE PRENOTA (\n    UTENTE_Username INTEGER NOT NULL,\n    GUIDA_COD INTEGER NOT NULL,\n    orari INTEGER NOT NULL,\n    giorniDisponibili INTEGER NOT NULL,\n    disponibile INTEGER NOT NULL,\n    stato INTEGER NOT NULL,\n    PRIMARY KEY (UTENTE_Username),\n    FOREIGN KEY (UTENTE_Username) REFERENCES UTENTE (Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (GUIDA_COD) REFERENCES GUIDA (COD)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE ASSEGNATA_A (\n    GUIDA_COD INTEGER NOT NULL,\n    TOUR_nome INTEGER NOT NULL,\n    PRIMARY KEY (GUIDA_COD, TOUR_nome),\n    FOREIGN KEY (GUIDA_COD) REFERENCES GUIDA (COD)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (TOUR_nome) REFERENCES TOUR (nome)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE SVOLGE (\n    GUIDA_COD INTEGER NOT NULL,\n    TRAGITTI_nome INTEGER NOT NULL,\n    PRIMARY KEY (GUIDA_COD, TRAGITTI_nome),\n    FOREIGN KEY (GUIDA_COD) REFERENCES GUIDA (COD)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (TRAGITTI_nome) REFERENCES TRAGITTI (nome)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE INCLUDE (\n    TOUR_nome INTEGER NOT NULL,\n    TRAGITTI_nome INTEGER NOT NULL,\n    PRIMARY KEY (TOUR_nome, TRAGITTI_nome),\n    FOREIGN KEY (TOUR_nome) REFERENCES TOUR (nome)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (TRAGITTI_nome) REFERENCES TRAGITTI (nome)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE VISITA (\n    PARCO_Nome INTEGER NOT NULL,\n    UTENTE_Username INTEGER NOT NULL,\n    data INTEGER NOT NULL,\n    oraEntrata INTEGER NOT NULL,\n    oraUscita INTEGER NOT NULL,\n    PRIMARY KEY (PARCO_Nome, UTENTE_Username),\n    FOREIGN KEY (PARCO_Nome) REFERENCES PARCO (Nome)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (UTENTE_Username) REFERENCES UTENTE (Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE GESTITO_DA (\n    PARCO_Nome INTEGER NOT NULL,\n    ENTE_Nome INTEGER NOT NULL,\n    PRIMARY KEY (PARCO_Nome, ENTE_Nome),\n    FOREIGN KEY (PARCO_Nome) REFERENCES PARCO (Nome)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (ENTE_Nome) REFERENCES ENTE (Nome)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);","itemsArray":[{"__type":"Table","_id":159,"_name":"GUIDA","_x":-1145,"_y":123,"_mag":false},{"__type":"Column","_id":165,"_name":"COD","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":159,"_tableIndex":0},{"__type":"Column","_id":166,"_name":"cognome","_typ