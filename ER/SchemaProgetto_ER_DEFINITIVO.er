"oldRenamingValue":"numCivico","renamingValue":"numCivico","showRenamingInput":false,"showRenamingRoleInput":false,"showCardinalityMenu":false,"showGeneralizationTypeMenu":false,"showExportMenu":false,"showNotes":false},"erRestructuring":{"model":{"uid":225,"erCode":"/* Entities */\nentity PARCO {\n    Nome (id),\n    regione,\n    superficie,\n    descrizione,\n    acessibile\n}\nentity ENTE {\n    CETS,\n    Nome (id)\n}\nentity STRUTTURA_RICETTIVA {\n    nome,\n    contatti,\n    servizi,\n    impiego_ecologico (optional),\n    trattamenti,\n    parcheggio,\n    CETS (optional),\n    Via (id),\n    numCivico (id),\n    CAP (id)\n}\nentity TRAGITTI {\n    punto_partenza,\n    nome (id),\n    difficolta,\n    durata,\n    descrizione\n}\nentity PIEDI\nentity BICI\nentity CAVALLO\nentity PERSONA {\n    COD_fiscale (id),\n    nome,\n    cognome,\n    dataNascita\n}\nentity TOUR {\n    nome (id),\n    maxPartecipanti,\n    stato,\n    data,\n    ora\n}\nentity SENIOR\nentity BAMBINO\nentity GRUPPO {\n    tipo,\n    ID (id),\n    totPartecipanti\n}\nentity FEEDBACK {\n    data (external),\n    valutazione,\n    ora (external),\n    commento,\n    tipo\n}\nentity ZONE_UMIDE\nentity TERRESTRI_E_MARINE\nentity RISERVA\nentity NATURALE\nentity GUIDA {\n    cod (id),\n    cognome,\n    nome,\n    voto,\n    licenza,\n    campo,\n    data_nascita\n}\nentity CALENDARIO {\n    idCalendario (id),\n    data,\n    oraInizio,\n    oraFine\n}\nentity UTENTE {\n    username (id),\n    password\n}\nentity CENTRO_VISITA {\n    nome (id),\n    indirizzo {\n        via,\n        CAP,\n        numCivico\n    },\n    orariApertura,\n    contatti {\n        telefono,\n        email\n    },\n    servizi,\n    note\n}\nentity NEWS {\n    data (id),\n    titolo (id),\n    autore,\n    testo,\n    foto\n}\n\n/* Relationships */\nrelationship GESTIONE (\n    PARCO: zero..many,\n    ENTE: zero..many\n)\nrelationship RISERVARE (\n    PERSONA: one..many,\n    STRUTTURA_RICETTIVA: zero..many\n) {\n    dataPrenotazione,\n    numStanze,\n    stato\n}\nrelationship INCLUDE (\n    TOUR: one..many,\n    TRAGITTI: zero..many\n)\nrelationship VISITA (\n    PARCO: zero..many,\n    PERSONA: zero..many\n) {\n    data,\n    oraEntrata,\n    oraUscita\n}\nrelationship APPARTIENE_A (\n    PERSONA: zero..many,\n    GRUPPO: zero..many\n)\nrelationship ESPRIME (\n    FEEDBACK: zero..one,\n    UTENTE: zero..many\n) {\n    anonimo\n}\nrelationship RIGUARDO (\n    FEEDBACK: one..one external,\n    TRAGITTI: zero..many\n)\nrelationship PRENOTA (\n    TOUR: one..many,\n    UTENTE: zero..many\n) {\n    orari,\n    giorniDisponibili,\n    disponibile,\n    stato\n}\nrelationship ASSEGNATA_A (\n    TOUR: one..many,\n    GUIDA: zero..many\n)\nrelationship SVOLGE (\n    GUIDA: one..many,\n    TRAGITTI: one..many\n)\nrelationship DISPONIBILE (\n    CALENDARIO: zero..many,\n    GUIDA: zero..many\n)\nrelationship SI_REGISTRA (\n    UTENTE: one..one,\n    PERSONA: zero..one\n)\nrelationship SI_RIVOLGE_A (\n    CENTRO_VISITA: one..many,\n    PERSONA: zero..many\n)\nrelationship SI_RIFERISCE_A (\n    CENTRO_VISITA: one..many,\n    PARCO: one..many\n)\nrelationship RELATIVO_A (\n    FEEDBACK: one..many,\n    GUIDA: one..many\n)\nrelationship POSSIEDE (\n    PARCO: one..many,\n    NEWS: one..one\n)\n\n/* Generalizations */\nTRAGITTI <= {\n    CAVALLO,\n    PIEDI,\n    BICI\n} (total, exclusive)\nPERSONA <= {\n    SENIOR,\n    BAMBINO\n} (partial, exclusive)\nPARCO <= {\n    NATURALE,\n    RISERVA,\n    ZONE_UMIDE,\n    TERRESTRI_E_MARINE\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"PARCO","_x":-556,"_y":-459,"_mag":false},{"__type":"Attribute","_id":2,"_name":"Nome","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":101,"_y":-88},{"__type":"Attribute","_id":4,"_name":"regione","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-118,"_y":73},{"__type":"Entity","_id":6,"_name":"ENTE","_x":58,"_y":-467,"_mag":false},{"__type":"Attribute","_id":7,"_name":"CETS","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":6,"_x":124,"_y":15},{"__type":"Attribute","_id":8,"_name":"Nome","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":6,"_x":128,"_y":-17},{"__type":"Relationship","_id":10,"_name":"GESTIONE","_x":-226,"_y":-460},{"__type":"Participation","_id":11,"_entityId":1,"_tableId":null,"_relationshipId":10,"_cardinality":"0_N","_externalIdentifier":false,"_role":""},{"__type":"Participation","_id":12,"_entityId":6,"_tableId":null,"_relationshipId":10,"_cardinality":"0_N","_externalIdentifier":false,"_role":""},{"__type":"Entity","_id":22,"_name":"STRUTTURA_RICETTIVA","_x":333,"_y":109,"_mag":false},{"__type":"Attribute","_id":24,"_name":"nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":22,"_x":232,"_y":-28},{"__type":"Attribute","_id":25,"_name":"contatti","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":22,"_x":234,"_y":10},{"__type":"Entity","_id":26,"_name":"TRAGITTI","_x":-2391,"_y":360,"_mag":false},{"__type":"Attribute","_id":27,"_name":"punto_partenza","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":26,"_x":-150,"_y":6},{"__type":"Attribute","_id":28,"_name":"nome","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":26,"_x":-151,"_y":-33},{"__type":"Entity","_id":29,"_name":"PIEDI","_x":-2391,"_y":601,"_mag":false},{"__type":"Entity","_id":30,"_name":"BICI","_x":-2601,"_y":600,"_mag":false},{"__type":"Entity","_id":31,"_name":"CAVALLO","_x":-2184,"_y":604,"_mag":false},{"__type":"Generalization","_id":32,"_type":"t_e","_entityId":26},{"__type":"GeneralizationChild","_id":33,"_entityId":31,"_generalizationId":32},{"__type":"GeneralizationChild","_id":34,"_entityId":29,"_generalizationId":32},{"__type":"GeneralizationChild","_id":35,"_entityId":30,"_genera