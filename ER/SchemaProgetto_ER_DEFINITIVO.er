ype":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":291,"_tableIndex":4},"299":{"__type":"Table","_id":299,"_name":"GESTITO_DA","_x":-362,"_y":-129,"_mag":false},"300":{"__type":"Column","_id":300,"_name":"PARCO_Nome","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":299,"_tableIndex":0},"301":{"__type":"ForeignKey","_id":301,"_referencingColumnId":300,"_referencedColumnId":204},"302":{"__type":"Column","_id":302,"_name":"ENTE_Nome","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":299,"_tableIndex":1},"303":{"__type":"ForeignKey","_id":303,"_referencingColumnId":302,"_referencedColumnId":220}},"sqlLinearCode":"<h3>Relational logical schema</h3>GUIDA (<u  style=\"text-decoration: underline;\">COD</u>, cognome, nome, data_nascita, campo, licenza)<br><br>\nTOUR (<u  style=\"text-decoration: underline;\">nome</u>, maxPartecipanti, stato)<br><br>\nTRAGITTI (<u  style=\"text-decoration: underline;\">nome</u>, punto_partenza, difficolta, durata, Type)<br><br>\nPARCO (<u  style=\"text-decoration: underline;\">Nome</u>, regione, tipo, superficie, Type)<br><br>\nUTENTE (<u  style=\"text-decoration: underline;\">Username</u>, password, Type)<br><br>\nENTE (<u  style=\"text-decoration: underline;\">Nome</u>, CETS)<br><br>\nGRUPPO (<u  style=\"text-decoration: underline;\">ID</u>, tipo, totPartecipanti)<br><br>\nCALENDARIO (<u  style=\"text-decoration: underline;\">idCalendario</u>, data, oraInizio, oraFine, GUIDA_COD)<br><br>\nFEEDBACK (<u  style=\"text-decoration: underline;\">TRAGITTI_nome</u>, <u  style=\"text-decoration: underline;\">data</u>, <u  style=\"text-decoration: underline;\">ora</u>, valutazione, commento, UTENTE_Username*)<br><br>\nALBERGO (<u  style=\"text-decoration: underline;\">nome</u>, indirizzo, contatti, servizi, impiego_ecologico*, parcheggio, CETS*, UTENTE_Username, dataPrenotazione, numStanze)<br><br>\nHAS_TRATTAMENTI (<u  style=\"text-decoration: underline;\">ALBERGO_nome</u>, <u  style=\"text-decoration: underline;\">TRATTAMENTI_trattamenti</u>)<br><br>\nAPPARTIENE_A (<u  style=\"text-decoration: underline;\">UTENTE_Username</u>, <u  style=\"text-decoration: underline;\">GRUPPO_ID</u>)<br><br>\nASSEGNATO_ALLA (<u  style=\"text-decoration: underline;\">GUIDA_COD</u>, <u  style=\"text-decoration: underline;\">FEEDBACK_TRAGITTI_nome</u>, <u  style=\"text-decoration: underline;\">FEEDBACK_data</u>, <u  style=\"text-decoration: underline;\">FEEDBACK_ora</u>, voto)<br><br>\nPRENOTA (<u  style=\"text-decoration: underline;\">UTENTE_Username</u>, GUIDA_COD, orari, giorniDisponibili, disponibile, stato)<br><br>\nASSEGNATA_A (<u  style=\"text-decoration: underline;\">GUIDA_COD</u>, <u  style=\"text-decoration: underline;\">TOUR_nome</u>)<br><br>\nSVOLGE (<u  style=\"text-decoration: underline;\">GUIDA_COD</u>, <u  style=\"text-decoration: underline;\">TRAGITTI_nome</u>)<br><br>\nINCLUDE (<u  style=\"text-decoration: underline;\">TOUR_nome</u>, <u  style=\"text-decoration: underline;\">TRAGITTI_nome</u>)<br><br>\nVISITA (<u  style=\"text-decoration: underline;\">PARCO_Nome</u>, <u  style=\"text-decoration: underline;\">UTENTE_Username</u>, data, oraEntrata, oraUscita)<br><br>\nGESTITO_DA (<u  style=\"text-decoration: underline;\">PARCO_Nome</u>, <u  style=\"text-decoration: underline;\">ENTE_Nome</u>)<br><br>\n\n<br><h3>Referential integrity constraints</h3>\n\n\n\n\n\n\nCALENDARIO (GUIDA_COD)  REFERENCES GUIDA  (COD)<br><br>\nFEEDBACK (TRAGITTI_nome)  REFERENCES TRAGITTI  (nome)<br><br>FEEDBACK (UTENTE_Username)  REFERENCES UTENTE  (Username)<br><br>\nALBERGO (UTENTE_Username)  REFERENCES UTENTE  (Username)<br><br>\nHAS_TRATTAMENTI (ALBERGO_nome)  REFERENCES ALBERGO  (nome)<br><br>\nAPPARTIENE_A (UTENTE_Username)  REFERENCES UTENTE  (Username)<br><br>APPARTIENE_A (GRUPPO_ID)  REFERENCES GRUPPO  (ID)<br><br>\nASSEGNATO_ALLA (GUIDA_COD)  REFERENCES GUIDA  (COD)<br><br>ASSEGNATO_ALLA (FEEDBACK_TRAGITTI_nome, FEEDBACK_data, FEEDBACK_ora)  REFERENCES FEEDBACK  (TRAGITTI_nome, data, ora)<br><br>\nPRENOTA (UTENTE_Username)  REFERENCES UTENTE  (Username)<br><br>PRENOTA (GUIDA_COD)  REFERENCES GUIDA  (COD)<br><br>\nASSEGNATA_A (GUIDA_COD)  REFERENCES GUIDA  (COD)<br><br>ASSEGNATA_A (TOUR_nome)  REFERENCES TOUR  (nome)<br><br>\nSVOLGE (GUIDA_COD)  REFERENCES GUIDA  (COD)<br><br>SVOLGE (TRAGITTI_nome)  REFERENCES TRAGITTI  (nome)<br><br>\nINCLUDE (TOUR_nome)  REFERENCES TOUR  (nome)<br><br>INCLUDE (TRAGITTI_nome)  REFERENCES TRAGITTI  (nome)<br><br>\nVISITA (PARCO_Nome)  REFERENCES PARCO  (Nome)<br><br>VISITA (UTENTE_Username)  REFERENCES UTENTE  (Username)<br><br>\nGESTITO_DA (PARCO_Nome)  REFERENCES PARCO  (Nome)<br><br>GESTITO_DA (ENTE_Nome)  REFERENCES ENTE  (Nome)<br><br>"},"edited":true,"sceneResetToken":1759843418724,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":null,"showNotesDataMenu":false}