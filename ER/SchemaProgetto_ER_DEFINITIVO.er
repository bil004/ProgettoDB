{"_main":{"step":"erDesign","restructuringHappened":true,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":225,"erCode":"/* Entities */\nentity PARCO {\n    Nome (id),\n    regione,\n    superficie,\n    descrizione,\n    acessibile\n}\nentity ENTE {\n    CETS,\n    Nome (id)\n}\nentity STRUTTURA_RICETTIVA {\n    nome,\n    contatti,\n    servizi,\n    impiego_ecologico (optional),\n    trattamenti,\n    parcheggio,\n    CETS (optional),\n    Via (id),\n    numCivico (id),\n    CAP (id)\n}\nentity TRAGITTI {\n    punto_partenza,\n    nome (id),\n    difficolta,\n    durata,\n    descrizione\n}\nentity PIEDI\nentity BICI\nentity CAVALLO\nentity PERSONA {\n    COD_fiscale (id),\n    nome,\n    cognome,\n    dataNascita\n}\nentity TOUR {\n    nome (id),\n    maxPartecipanti,\n    stato,\n    data,\n    ora\n}\nentity SENIOR\nentity BAMBINO\nentity GRUPPO {\n    tipo,\n    ID (id),\n    totPartecipanti\n}\nentity FEEDBACK {\n    data (external),\n    valutazione,\n    ora (external),\n    commento,\n    tipo\n}\nentity ZONE_UMIDE\nentity TERRESTRI_E_MARINE\nentity RISERVA\nentity NATURALE\nentity GUIDA {\n    cod (id),\n    cognome,\n    nome,\n    voto,\n    licenza,\n    campo,\n    data_nascita\n}\nentity CALENDARIO {\n    idCalendario (id),\n    data,\n    oraInizio,\n    oraFine\n}\nentity UTENTE {\n    username (id),\n    password\n}\nentity CENTRO_VISITA {\n    nome (id),\n    indirizzo {\n        via,\n        CAP,\n        numCivico\n    },\n    orariApertura,\n    contatti {\n        telefono,\n        email\n    },\n    servizi,\n    note\n}\nentity NEWS {\n    data (id),\n    titolo (id),\n    autore,\n    testo,\n    foto\n}\n\n/* Relationships */\nrelationship GESTIONE (\n    PARCO: zero..many,\n    ENTE: zero..many\n)\nrelationship RISERVARE (\n    PERSONA: one..many,\n    STRUTTURA_RICETTIVA: zero..many\n) {\n    dataPrenotazione,\n    numStanze,\n    stato\n}\nrelationship INCLUDE (\n    TOUR: one..many,\n    TRAGITTI: zero..many\n)\nrelationship VISITA (\n    PARCO: zero..many,\n    PERSONA: zero..many\n) {\n    data,\n    oraEntrata,\n    oraUscita\n}\nrelationship APPARTIENE_A (\n    PERSONA: zero..many,\n    GRUPPO: zero..many\n)\nrelationship ESPRIME (\n    FEEDBACK: zero..one,\n    UTENTE: zero..many\n) {\n    anonimo\n}\nrelationship RIGUARDO (\n    FEEDBACK: one..one external,\n    TRAGITTI: zero..many\n)\nrelationship PRENOTA (\n    TOUR: one..many,\n    UTENTE: zero..many\n) {\n    orari,\n    giorniDisponibili,\n    disponibile,\n    stato\n}\nrelationship ASSEGNATA_A (\n    TOUR: one..many,\n    GUIDA: zero..many\n)\nrelationship SVOLGE (\n    GUIDA: one..many,\n    TRAGITTI: one..many\n)\nrelationship DISPONIBILE (\n    CALENDARIO: zero..many,\n    GUIDA: zero..many\n)\nrelationship SI_REGISTRA (\n    UTENTE: one..one,\n    PERSONA: zero..one\n)\nrelationship SI_RIVOLGE_A (\n    CENTRO_VISITA: one..many,\n    PERSONA: zero..many\n)\nrelationship SI_RIFERISCE_A (\n    CENTRO_VISITA: one..many,\n    PARCO: one..many\n)\nrelationship RELATIVO_A (\n    FEEDBACK: one..many,\n    GUIDA: one..many\n)\nrelationship POSSIEDE (\n    PARCO: one..many,\n    NEWS: one..one\n)\n\n/* Generalizations */\nTRAGITTI <= {\n    CAVALLO,\n    PIEDI,\n    BICI\n} (total, exclusive)\nPERSONA <= {\n    SENIOR,\n    BAMBINO\n} (partial, exclusive)\nPARCO <= {\n    NATURALE,\n    RISERVA,\n    ZONE_UMIDE,\n    TERRESTRI_E_MARINE\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"PARCO","_x":-556,"_y":-459,"_mag":false},{"__type":"Attribute","_id":2,"_name":"Nome","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":101,"_y":-88},{"__type":"Attribute","_id":4,"_name":"regione","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-118,"_y":73},{"__type":"Entity","_id":6,"_name":"ENTE","_x":58,"_y":-467,"_mag":false},{"__type":"Attribute","_id":7