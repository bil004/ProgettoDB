ableId":420,"_tableIndex":0},"422":{"__type":"ForeignKey","_id":422,"_referencingColumnId":421,"_referencedColumnId":248},"423":{"__type":"Column","_id":423,"_name":"CENTRO_VISITA_nomeCentro","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":420,"_tableIndex":1},"424":{"__type":"ForeignKey","_id":424,"_referencingColumnId":423,"_referencedColumnId":326},"425":{"__type":"Table","_id":425,"_name":"RELATIVO_A","_x":-2108,"_y":-59,"_mag":false},"426":{"__type":"Column","_id":426,"_name":"GUIDA_numTesserino","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":425,"_tableIndex":0},"427":{"__type":"ForeignKey","_id":427,"_referencingColumnId":426,"_referencedColumnId":311},"428":{"__type":"Column","_id":428,"_name":"FEEDBACK_TRAGITTI_nomeTragitto","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":425,"_tableIndex":1},"429":{"__type":"ForeignKey","_id":429,"_referencingColumnId":428,"_referencedColumnId":343},"430":{"__type":"Column","_id":430,"_name":"FEEDBACK_data","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":425,"_tableIndex":2},"431":{"__type":"ForeignKey","_id":431,"_referencingColumnId":430,"_referencedColumnId":346},"432":{"__type":"Column","_id":432,"_name":"FEEDBACK_ora","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":425,"_tableIndex":3},"433":{"__type":"ForeignKey","_id":433,"_referencingColumnId":432,"_referencedColumnId":347},"434":{"__type":"Column","_id":434,"_name":"PARCO_nomeParco","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":334,"_tableIndex":5},"435":{"__type":"ForeignKey","_id":435,"_referencingColumnId":434,"_referencedColumnId":248},"436":{"__type":"Column","_id":436,"_name":"UTENTE_username","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":341,"_tableIndex":6},"437":{"__type":"ForeignKey","_id":437,"_referencingColumnId":436,"_referencedColumnId":319},"438":{"__type":"Column","_id":438,"_name":"anonimo","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":341,"_tableIndex":7}},"sqlLinearCode":""},"edited":false,"sceneResetToken":1760365794616,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showOneToManyTypeBRelationshipMenu":false,"showOneToOneTypeBRelationshipMenu":false,"showOneToOneTypeCRelationshipMenu":false,"showExportMenu":false,"showNotes":false},"schemaDesign":{"model":{"uid":439,"erCode":"/* Entities */\nentity PARCO {\n    nomeParco (id),\n    regione,\n    superficie,\n    descrizione,\n    acessibile\n}\nentity ENTE {\n    CETS,\n    nomeEnte (id)\n}\nentity STRUTTURA_RICETTIVA {\n    nome,\n    contatti,\n    servizi,\n    impiego_ecologico (optional),\n    trattamenti,\n    parcheggio,\n    CETS (optional),\n    Via (id),\n    numCivico (id),\n    CAP (id)\n}\nentity TRAGITTI {\n    punto_partenza,\n    nomeTragitto (id),\n    difficolta,\n    durata,\n    descrizione\n}\nentity PIEDI\nentity BICI\nentity CAVALLO\nentity PERSONA {\n    COD_fiscale (id),\n    nome,\n    cognome,\n    dataNascita\n}\nentity TOUR {\n    nomeTour (id),\n    maxPartecipanti,\n    stato,\n    data,\n    ora\n}\nentity SENIOR\nentity BAMBINO\nentity GRUPPO {\n    tipo,\n    nomeGruppo (id),\n    totPartecipanti,\n    classe (optional)\n}\nentity FEEDBACK {\n    data (external),\n    valutazione,\n    ora (external),\n    commento,\n    tipo\n}\nentity ZONE_UMIDE\nentity TERRESTRI_E_MARINE\nentity RISERVA\nentity NATURALE\nentity GUIDA {\n    numTesserino (id),\n    voto,\n    licenza,\n    campo\n}\nentity CALENDARIO {\n    data (external),\n    oraInizio (external),\n    oraFine (external),\n    note\n}\nentity UTENTE {\n    username (id),\n    password,\n    email,\n    telefono\n}\nentity CENTRO_VISITA {\n    nomeCentro (id),\n    indirizzo {\n        via,\n        CAP,\n        numCivico\n    },\n    orarioApertura,\n    contatti {\n        telefono,\n        email\n    },\n    servizi,\n    note,\n    orarioChiusura\n}\nentity NEWS {\n    data (id),\n    titolo (id),\n    autore,\n    testo,\n    foto\n}\n\n/* Relationships */\nrelationship GESTIONE (\n    PARCO: zero..many,\n    ENTE: zero..many\n)\nrelationship RISERVARE (\n    PERSONA: one..many,\n    STRUTTURA_RICETTIVA: zero..many\n) {\n    dataPrenotazione,\n    numStanze,\n    stato\n}\nrelationship INCLUDE (\n    TOUR: one..many,\n    TRAGITTI: zero..many\n)\nrelationship VISITA (\n    PARCO: zero..many,\n    PERSONA: zero..many\n) {\n    data,\n    oraEntrata,\n    oraUscita\n}\nrelationship APPARTIENE_A (\n    PERSONA: zero..many,\n    GRUPPO: zero..many\n)\nrelationship ESPRIME (\n    FEEDBACK: zero..one,\n    UTENTE: zero..many\n) {\n    anonimo\n}\nrelationship RIGUARDO (\n    FEEDBACK: one..one external,\n    TRAGITTI: zero..many\n)\nrelationship PRENOTA (\n    TOUR: one..many,\n    UTENTE: zero..many\n) {\n    orario,\n    giorniDisponibili,\n    disponibile,\n    stato,\n    data\n}\nrelationship ASSEGNATA_A (\n    TOUR: one..many,\n    GUIDA: zero..many\n)\nrelationship SVOLGE (\n    GUIDA: one..many,\n    TRAGITTI: one..many\n)\nrelationship DISPONIBILE (\n    CALENDARIO: one..one external,\n    GUIDA: one..many\n)\nrelationship SI_REGISTRA (\n    UTENTE: one..one,\n    PERSONA: zero..one\n)\nrelationship SI_RIVOLGE_A (\n    CENTRO_VISITA: one..many,\n    PERSONA: zero..many\n)\nrelationship SI_RIFERISCE_A (\n    CENTRO_VISITA: one..many,\n    PARCO: one..many\n)\nrelationship RELATIVO_A (\n    FEEDBACK: one..many,\n    GUIDA: one..many\n)\nrelationship POSSIEDE (\n    PARCO: one..many,\n    NEWS: one..one\n)\n\n/* Generalizations */\nTRAGITTI <= {\n    CAVALLO,\n    PIEDI,\n    BICI\n} (total, exclusive)\nPERSONA <= {\n    SENIOR,\n    BAMBINO\n} (partial, exclusive)\nPARCO <= {\n    NATURALE,\n    RISERVA,\n    ZONE_UMIDE,\n    TERRESTRI_E_MARINE\n} (partial, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE PARCO (\n    nomeParco INTEGER NOT NULL,\n    regione INTEGER NOT NULL,\n    superficie INTEGER NOT NULL,\n    descrizione INTEGER NOT NULL,\n    acessibile INTEGER NOT NULL,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (nomeParco)\n);\nCREATE TABLE ENTE (\n    nomeEnte INTEGER NOT NULL,\n    CETS INTEGER NOT NULL,\n    PRIMARY KEY (nomeEnte)\n);\nCREATE TABLE STRUTTURA_RICETTIVA (\n    Via INTEGER NOT NULL,\n    numCivico INTEGER NOT NULL,\n    CAP INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    contatti INTEGER NOT NULL,\n    servizi INTEGER NOT NULL,\n    impiego_ecologico INTEGER,\n    trattamenti INTEGER NOT NULL,\n    parcheggio INTEGER NOT NULL,\n    CETS INTEGER,\n    PRIMARY KEY (Via, numCivico, CAP)\n);\nCREATE TABLE TRAGITTI (\n    nomeTragitto INTEGER NOT NULL,\n    punto_partenza INTEGER NOT NULL,\n    difficolta INTEGER NOT NULL,\n    durata INTEGER NOT NULL,\n    descrizione INTEGER NOT NULL,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (nomeTragitto)\n);\nCREATE TABLE PERSONA (\n    COD_fiscale INTEGER NOT NULL,\n    nome INTEGER NOT NULL,\n    cognome INTEGER NOT NULL,\n    dataNascita INTEGER NOT NULL,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (COD_fiscale)\n);\nCREATE TABLE TOUR (\n    nomeTour INTEGER NOT NULL,\n    maxPartecipanti INTEGER NOT NULL,\n    stato INTEGER NOT NULL,\n    data INTEGER NOT NULL,\n    ora INTEGER NOT NULL,\n    PRIMARY KEY (nomeTour)\n);\nCREATE TABLE GRUPPO (\n    nomeGruppo INTEGER NOT NULL,\n    tipo INTEGER NOT NULL,\n    totPartecipanti INTEGER NOT NULL,\n    classe INTEGER,\n    PRIMARY KEY (nomeGruppo)\n);\nCREATE TABLE GUIDA (\n    numTesserino INTEGER NOT NULL,\n    voto INTEGER NOT NULL,\n    licenza INTEGER NOT NULL,\n    campo INTEGER NOT NULL,\n    PRIMARY KEY (numTesserino)\n);\nCREATE TABLE CENTRO_VISITA (\n    nomeCentro INTEGER NOT NULL,\n    indirizzo INTEGER NOT NULL,\n    orarioApertura INTEGER NOT NULL,\n    servizi INTEGER NOT NULL,\n    note INTEGER NOT NULL,\n    orarioChiusura INTEGER NOT NULL,\n    telefono INTEGER NOT NULL,\n    email INTEGER NOT NULL,\n    PRIMARY KEY (nomeCentro)\n);\nCREATE TABLE UTENTE (\n    username INTEGER NOT NULL,\n    password INTEGER NOT NULL,\n    email INTEGER NOT NULL,\n    telefono INTEGER NOT NULL,\n    PERSONA_COD_fiscale INTEGER NOT NULL,\n    PRIMARY KEY (username),\n    FOREIGN KEY (PERSONA_COD_fiscale) REFERENCES PERSONA (COD_fiscale)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE NEWS (\n    data INTEGER NOT NULL,\n    titolo INTEGER NOT NULL,\n    autore INTEGER NOT NULL,\n    testo INTEGER NOT NULL,\n    foto INTEGER NOT NULL,\n    PARCO_nomeParco INTEGER NOT NULL,\n    PRIMARY KEY (data, titolo),\n    FOREIGN KEY (PARCO_nomeParco) REFERENCES PARCO (nomeParco)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE FEEDBACK (\n    TRAGITTI_nomeTragitto INTEGER NOT NULL,\n    data INTEGER NOT NULL,\n    ora INTEGER NOT NULL,\n    valutazione INTEGER NOT NULL,\n    commento INTEGER NOT NULL,\n    tipo INTEGER NOT NULL,\n    UTENTE_username INTEGER,\n    anonimo INTEGER,\n    PRIMARY KEY (TRAGITTI_nomeTragitto, data, ora),\n    FOREIGN KEY (TRAGITTI_nomeTragitto) REFERENCES TRAGITTI (nomeTragitto)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (UTENTE_username) REFERENCES UTENTE (username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE CALENDARIO (\n    GUIDA_numTesserino INTEGER NOT NULL,\n    data INTEGER NOT NULL,\n    oraInizio INTEGER NOT NULL,\n    oraFine INTEGER NOT NULL,\n    note INTEGER NOT NULL,\n    PRIMARY KEY (GUIDA_numTesserino, data, oraInizio, oraFine),\n    FOREIGN KEY (GUIDA_numTesserino) REFERENCES GUIDA (numTesserino)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE GESTIONE (\n    PARCO_nomeParco INTEGER NOT NULL,\n    ENTE_nomeEnte INTEGER NOT NULL,\n    PRIMARY KEY (PARCO_nomeParco, ENTE_nomeEnte),\n    FOREIGN KEY (PARCO_nomeParco) REFERENCES PARCO (nomeParco)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (ENTE_nomeEnte) REFERENCES ENTE (nomeEnte)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE RISERVARE (\n    STRUTTURA_RICETTIVA_Via INTEGER NOT NULL,\n    STRUTTURA_RICETTIVA_numCivico INTEGER NOT NULL,\n    STRUTTURA_RICETTIVA_CAP INTEGER NOT NULL,\n    PERSONA_COD_fiscale INTEGER NOT NULL,\n    dataPrenotazione INTEGER NOT NULL,\n    numStanze INTEGER NOT NULL,\n    stato INTEGER NOT NULL,\n    PRIMARY KEY (STRUTTURA_RICETTIVA_Via, STRUTTURA_RICETTIVA_numCivico, STRUTTURA_RICETTIVA_CAP, PERSONA_COD_fiscale),\n    FOREIGN KEY (STRUTTURA_RICETTIVA_Via, STRUTTURA_RICETTIVA_numCivico, STRUTTURA_RICETTIVA_CAP) REFERENCES STRUTTURA_RICETTIVA (Via, numCivico, CAP)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (PERSONA_COD_fiscale) REFERENCES PERSONA (COD_fiscale)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE INCLUDE (\n    TRAGITTI_nomeTragitto INTEGER NOT NULL,\n    TOUR_nomeTour INTEGER NOT NULL,\n    PRIMARY KEY (TRAGITTI_nomeTragitto, TOUR_nomeTour),\n    FOREIGN KEY (TRAGITTI_nomeTragitto) REFERENCES TRAGITTI (nomeTragitto)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (TOUR_nomeTour) REFERENCES TOUR (nomeTour)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE VISITA (\n    PARCO_nomeParco INTEGER NOT NULL,\n    PERSONA_COD_fiscale INTEGER NOT NULL,\n    data INTEGER NOT NULL,\n    oraEntrata INTEGER NOT NULL,\n    oraUscita INTEGER NOT NULL,\n    PRIMARY KEY (PARCO_nomeParco, PERSONA_COD_fiscale),\n    FOREIGN KEY (PARCO_nomeParco) REFERENCES PARCO (nomeParco)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (PERSONA_COD_fiscale) REFERENCES PERSONA (COD_fiscale)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE APPARTIENE_A (\n    PERSONA_COD_fiscale INTEGER NOT NULL,\n    GRUPPO_nomeGruppo INTEGER NOT NULL,\n    PRIMARY KEY (PERSONA_COD_fiscale, GRUPPO_nomeGruppo),\n    FOREIGN KEY (PERSONA_COD_fiscale) REFERENCES PERSONA (COD_fiscale)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (GRUPPO_nomeGruppo) REFERENCES GRUPPO (nomeGruppo)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE PRENOTA (\n    TOUR_nomeTour INTEGER NOT NULL,\n    UTENTE_username INTEGER NOT NULL,\n    orario INTEGER NOT NULL,\n    giorniDisponibili INTEGER NOT NULL,\n    disponibile INTEGER NOT NULL,\n    stato INTEGER NOT NULL,\n    data INTEGER NOT NULL,\n    PRIMARY KEY (TOUR_nomeTour, UTENTE_username),\n    FOREIGN KEY (TOUR_nomeTour) REFERENCES TOUR (nomeTour)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (UTENTE_username) REFERENCES UTENTE (username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE ASSEGNATA_A (\n    TOUR_nomeTour INTEGER NOT NULL,\n    GUIDA_numTesserino INTEGER NOT NULL,\n    PRIMARY KEY (TOUR_nomeTour, GUIDA_numTesserino),\n    FOREIGN KEY (TOUR_nomeTour) REFERENCES TOUR (nomeTour)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (GUIDA_numTesserino) REFERENCES GUIDA (numTesserino)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE SVOLGE (\n    TRAGITTI_nomeTragitto INTEGER NOT NULL,\n    GUIDA_numTesserino INTEGER NOT NULL,\n    PRIMARY KEY (TRAGITTI_nomeTragitto, GUIDA_numTesserino),\n    FOREIGN KEY (TRAGITTI_nomeTragitto) REFERENCES TRAGITTI (nomeTragitto)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (GUIDA_numTesserino) REFERENCES GUIDA (numTesserino)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE SI_RIVOLGE_A (\n    PERSONA_COD_fiscale INTEGER NOT NULL,\n    CENTRO_VISITA_nomeCentro INTEGER NOT NULL,\n    PRIMARY KEY (PERSONA_COD_fiscale, CENTRO_VISITA_nomeCentro),\n    FOREIGN KEY (PERSONA_COD_fiscale) REFERENCES PERSONA (COD_fiscale)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (CENTRO_VISITA_nomeCentro) REFERENCES CENTRO_VISITA (nomeCentro)\n    ON DELETE NO ACTION\n