4":{"__type":"Attribute","_id":234,"_name":"email","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":164,"_x":-117,"_y":2},"235":{"__type":"Attribute","_id":235,"_name":"telefono","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":164,"_x":-112,"_y":-62}},"sqlLinearCode":""},"edited":false,"sceneResetToken":1764153037674,"selectedItemId":null,"selectedTool":null,"oldRenamingValue":"nomeGruppo","renamingValue":"nomeGruppo","showRenamingInput":false,"showRenamingRoleInput":false,"showCardinalityMenu":false,"showGeneralizationTypeMenu":false,"showExportMenu":false,"showNotes":false},"erRestructuring":{"model":{"uid":243,"erCode":"/* Entities */\nentity PARCO {\n    nomeParco (id),\n    regione,\n    superficie,\n    descrizione,\n    acessibile\n}\nentity ENTE {\n    CETS,\n    nomeEnte (id)\n}\nentity STRUTTURA_RICETTIVA {\n    nome,\n    contatti,\n    servizi,\n    impiego_ecologico (optional),\n    trattamenti,\n    parcheggio,\n    CETS (optional),\n    Via (id),\n    numCivico (id),\n    CAP (id)\n}\nentity TRAGITTI {\n    punto_partenza,\n    nomeTragitto (id),\n    difficolta,\n    durata,\n    descrizione\n}\nentity PIEDI\nentity BICI\nentity CAVALLO\nentity PERSONA {\n    COD_fiscale (id),\n    nome,\n    cognome,\n    dataNascita\n}\nentity TOUR {\n    nomeTour (id),\n    maxPartecipanti,\n    stato,\n    data,\n    ora\n}\nentity SENIOR\nentity BAMBINO\nentity GRUPPO {\n    tipo,\n    nomeGruppo (id),\n    classe (optional)\n}\nentity FEEDBACK {\n    data (external),\n    valutazione,\n    ora (external),\n    commento,\n    tipo\n}\nentity ZONE_UMIDE\nentity TERRESTRI_E_MARINE\nentity RISERVA\nentity NATURALE\nentity GUIDA {\n    numTesserino (id),\n    voto,\n    licenza,\n    campo\n}\nentity CALENDARIO {\n    data (id),\n    oraInizio (id),\n    oraFine (id),\n    note\n}\nentity UTENTE {\n    username (id),\n    password,\n    email,\n    telefono\n}\nentity CENTRO_VISITA {\n    nomeCentro (id),\n    indirizzo {\n        via,\n        CAP,\n        numCivico\n    },\n    orarioApertura,\n    contatti {\n        telefono,\n        email\n    },\n    servizi,\n    note,\n    orarioChiusura\n}\nentity NEWS {\n    data (id),\n    titolo (id),\n    autore,\n    testo,\n    foto\n}\n\n/* Relationships */\nrelationship GESTIONE (\n    PARCO: one..many,\n    ENTE: one..many\n)\nrelationship RISERVARE (\n    PERSONA: zero..many,\n    STRUTTURA_RICETTIVA: zero..many\n) {\n    dataPrenotazione,\n    numStanze,\n    stato\n}\nrelationship INCLUDE (\n    TOUR: one..many,\n    TRAGITTI: zero..many\n)\nrelationship VISITA (\n    PARCO: zero..many,\n    PERSONA: zero..many\n) {\n    data,\n    oraEntrata,\n    oraUscita\n}\nrelationship APPARTIENE_A (\n    PERSONA: zero..one,\n    GRUPPO: zero..many\n)\nrelationship ESPRIME (\n    FEEDBACK: one..one,\n    UTENTE: zero..many\n) {\n    anonimo\n}\nrelationship RIGUARDO (\n    FEEDBACK: one..one external,\n    TRAGITTI: zero..many\n)\nrelationship PRENOTA (\n    TOUR: zero..many,\n    UTENTE: zero..many\n) {\n    orario,\n    giorniDisponibili,\n    disponibile,\n    stato,\n    data\n}\nrelationship ASSEGNATA_A (\n    TOUR: one..many,\n    GUIDA: zero..many\n)\nrelationship SVOLGE (\n    GUIDA: one..many,\n    TRAGITTI: one..many\n)\nrelationship DISPONIBILE (\n    CALENDARIO: one..many,\n    GUIDA: one..many\n)\nrelationship SI_REGISTRA (\n    UTENTE: one..one,\n    PERSONA: zero..one\n)\nrelationship SI_RIVOLGE_A (\n    CENTRO_VISITA: one..many,\n    PERSONA: zero..many\n)\nrelationship SI_RIFERISCE_A (\n    CENTRO_VISITA: one..many,\n    PARCO: one..many\n)\nrelationship RELATIVO_A (\n    FEEDBACK: one..many,\n    GUIDA: one..many\n)\nrelationship POSSIEDE (\n    PARCO: one..many,\n    NEWS: one..one\n)\n\n/* Generalizations */\nTRAGITTI <= {\n    CAVALLO,\n    PIEDI,\n    BICI\n} (total, exclusive)\nPERSONA <= {\n    SENIOR,\n    BAMBINO\n} (partial, exclusive)\nPARCO <= {\n    NATURALE,\n    RISERVA,\n    ZONE_UMIDE,\n    TERRESTRI_E_MARINE\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"PARCO","_x":-556,"_y":-459,"_mag":false},{"__type":"Attribute","_id":2,"_name":"nomeParco","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":125,"_y":-87},{"__type":"Attribute","_id":4,"_name":"regione","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-95,"_y":79},{"__type":"Entity","_id":6,"_name":"ENTE","_x":124,"_y":-460,"_mag":false},{"__type":"Attribute","_id":7,"_name":"CETS","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":6,"_x":124,"_y":15},{"__type":"Attribute","_id":8,"_name":"nomeEnte","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":6,"_x":128,"_y":-17},{"__type":"Relationship","_id":10,"_name":"GESTIONE","_x":-212,"_y":-458},{"__type":"Participation","_id":11,"_entityId":1,"_tableId":null,"_relationshipId":10,"_cardinality":"1_N","_externalIdentifier":false,"_role":""},{"__type":"Participation","_id":12,"_entityId":6,"_tableId":null,"_relationshipId":10,"_cardinality":"1_N","_externalIdentifier":false,"_role":""},{"__type":"Entity","_id":22,"_name":"STRUTTURA_RICETTIVA","_x":331,"_y":124,"_mag":false},{"__type":"Attribute","_id":24,"_name":"nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":22,"_x":232,"_y":-28},{"__type":"Attribute","_id":25,"_name":"contatti","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":22,"_x":234,"_y":10},{"__type":"Entity","_id":26,"_name":"TRAGITTI","_x":-2391,"_y":360,"_mag":false},{"__type":"Attribute","_id":27,"_name":"punto_partenza","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":26,"_x":-150,"_y":6},{"__type":"Attribute","_id":28,"_name":"nomeTragitto","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":26,"_x":-150,"_y":-32},{"__type":"Entity",