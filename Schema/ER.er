d":341},"425":{"__type":"Table","_id":425,"_name":"SI_RIFERISCE_A","_x":-915,"_y":-454,"_mag":false},"426":{"__type":"Column","_id":426,"_name":"PARCO_nomeParco","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":425,"_tableIndex":0},"427":{"__type":"ForeignKey","_id":427,"_referencingColumnId":426,"_referencedColumnId":292},"428":{"__type":"Column","_id":428,"_name":"CENTRO_VISITA_nomeCentro","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":425,"_tableIndex":1},"429":{"__type":"ForeignKey","_id":429,"_referencingColumnId":428,"_referencedColumnId":341},"430":{"__type":"Table","_id":430,"_name":"RELATIVO_A","_x":-1978,"_y":27,"_mag":false},"431":{"__type":"Column","_id":431,"_name":"GUIDA_numTesserino","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":430,"_tableIndex":0},"432":{"__type":"ForeignKey","_id":432,"_referencingColumnId":431,"_referencedColumnId":254},"433":{"__type":"Column","_id":433,"_name":"FEEDBACK_TRAGITTI_nomeTragitto","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":430,"_tableIndex":1},"434":{"__type":"ForeignKey","_id":434,"_referencingColumnId":433,"_referencedColumnId":279},"435":{"__type":"Column","_id":435,"_name":"FEEDBACK_data","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":430,"_tableIndex":2},"436":{"__type":"ForeignKey","_id":436,"_referencingColumnId":435,"_referencedColumnId":282},"437":{"__type":"Column","_id":437,"_name":"FEEDBACK_ora","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":430,"_tableIndex":3},"438":{"__type":"ForeignKey","_id":438,"_referencingColumnId":437,"_referencedColumnId":283},"439":{"__type":"Column","_id":439,"_name":"PARCO_nomeParco","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":349,"_tableIndex":5},"440":{"__type":"ForeignKey","_id":440,"_referencingColumnId":439,"_referencedColumnId":292},"441":{"__type":"Column","_id":441,"_name":"GRUPPO_nomeGruppo","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":314,"_tableIndex":5},"442":{"__type":"ForeignKey","_id":442,"_referencingColumnId":441,"_referencedColumnId":327}},"sqlLinearCode":"<h3>Relational logical schema</h3>CALENDARIO (<u  style=\"text-decoration: underline;\">data</u>, <u  style=\"text-decoration: underline;\">oraInizio</u>, <u  style=\"text-decoration: underline;\">oraFine</u>, note)<br><br>\nGUIDA (<u  style=\"text-decoration: underline;\">numTesserino</u>, voto, licenza, campo)<br><br>\nTRAGITTI (<u  style=\"text-decoration: underline;\">nomeTragitto</u>, punto_partenza, difficolta, durata, descrizione, tipo)<br><br>\nTOUR (<u  style=\"text-decoration: underline;\">nomeTour</u>, maxPartecipanti, stato, data, ora)<br><br>\nPARCO (<u  style=\"text-decoration: underline;\">nomeParco</u>, regione, superficie, descrizione, acessibile, tipo)<br><br>\nENTE (<u  style=\"text-decoration: underline;\">nomeEnte</u>, CETS)<br><br>\nSTRUTTURA_RICETTIVA (<u  style=\"text-decoration: underline;\">Via</u>, <u  style=\"text-decoration: underline;\">numCivico</u>, <u  style=\"text-decoration: underline;\">CAP</u>, nome, contatti, servizi, impiego_ecologico*, trattamenti, parcheggio, CETS*)<br><br>\nGRUPPO (<u  style=\"text-decoration: underline;\">nomeGruppo</u>, tipo, classe*)<br><br>\nCENTRO_VISITA (<u  style=\"text-decoration: underline;\">nomeCentro</u>, indirizzo, orarioApertura, servizi, note, orarioChiusura, telefono, email)<br><br>\nFEEDBACK (<u  style=\"text-decoration: underline;\">TRAGITTI_nomeTragitto</u>, <u  style=\"text-decoration: underline;\">data</u>, <u  style=\"text-decoration: underline;\">ora</u>, valutazione, commento, tipo, UTENTE_username, anonimo)<br><br>\nPERSONA (<u  style=\"text-decoration: underline;\">COD_fiscale</u>, nome, cognome, dataNascita, tipo, GRUPPO_nomeGruppo*)<br><br>\nUTENTE (<u  style=\"text-decoration: underline;\">username</u>, password, email, telefono, PERSONA_COD_fiscale)<br><br>\nNEWS (<u  style=\"text-decoration: underline;\">data</u>, <u  style=\"text-decoration: underline;\">titolo</u>, autore, testo, foto, PARCO_nomeParco)<br><br>\nDISPONIBILE (<u  style=\"text-decoration: underline;\">CALENDARIO_data</u>, <u  style=\"text-decoration: underline;\">CALENDARIO_oraInizio</u>, <u  style=\"text-decoration: underline;\">CALENDARIO_oraFine</u>, <u  style=\"text-decoration: underline;\">GUIDA_numTesserino</u>)<br><br>\nGESTIONE (<u  style=\"text-decoration: underline;\">PARCO_nomeParco</u>, <u  style=\"text-decoration: underline;\">ENTE_nomeEnte</u>)<br><br>\nRISERVARE (<u  style=\"text-decoration: underline;\">STRUTTURA_RICETTIVA_Via</u>, <u  style=\"text-decoration: underline;\">STRUTTURA_RICETTIVA_numCivico</u>, <u  style=\"text-decoration: underline;\">STRUTTURA_RICETTIVA_CAP</u>, <u  style=\"text-decoration: underline;\">PERSONA_COD_fiscale</u>, dataPrenotazione, numStanze, stato)<br><br>\nINCLUDE (<u  style=\"text-decoration: underline;\">TRAGITTI_nomeTragitto</u>, <u  style=\"text-decoration: underline;\">TOUR_nomeTour</u>)<br><br>\nVISITA (<u  style=\"text-decoration: underline;\">PARCO_nomeParco</u>, <u  style=\"text-decoration: underline;\">PERSONA_COD_fiscale</u>, data, oraEntrata, oraUscita)<br><br>\nPRENOTA (<u  style=\"text-decoration: underline;\">TOUR_nomeTour</u>, <u  style=\"text-decoration: underline;\">UTENTE_username</u>, orario, giorniDisponibili, disponibile, stato, data)<br><br>\nASSEGNATA_A (<u  style=\"text-decoration: underline;\">GUIDA_numTesserino</u>, <u  style=\"text-decoration: underline;\">TOUR_nomeTour</u>)<br><br>\nSVOLGE (<u  style=\"text-decoration: underline;\">GUIDA_numTesserino</u>, <u  style=\"text-decoration: underline;\">TRAGITTI_nomeTragitto</u>)<br><br>\nSI_RIVOLGE_A (<u  style=\"text-decoration: underline;\">PERSONA_COD_fiscale</u>, <u  style=\"text-decoration: underline;\">CENTRO_VISITA_nomeCentro</u>)<br><br>\nSI_RIFERISCE_A (<u  style=\"text-decoration: underline;\">PARCO_nomeParco</u>, <u  style=\"text-decoration: underline;\">CENTRO_VISITA_nomeCentro</u>)<br><br>\nRELATIVO_A (<u  style=\"text-decoration: underline;\">GUIDA_numTesserino</u>, <u  style=\"text-decoration: underline;\">FEEDBACK_TRAGITTI_nomeTragitto</u>, <u  style=\"text-decoration: underline;\">FEEDBACK_data</u>, <u  style=\"text-decoration: underline;\">FEEDBACK_ora</u>)<br><br>\n\n<br><h3>Referential integrity constraints</h3>\n\n\n\n\n\n\n\n\nFEEDBACK (TRAGITTI_nomeTragitto)  REFERENCES TRAGITTI  (nomeTragitto)<br><br>FEEDBACK (UTENTE_username)  REFERENCES UTENTE  (username)<br><br>\nPERSONA (GRUPPO_nomeGruppo)  REFERENCES GRUPPO  (nomeGruppo)<br><br>\nUTENTE (PERSONA_COD_fiscale)  REFERENCES PERSONA  (COD_fiscale)<br><br>\nNEWS (PARCO_nomeParco)  REFERENCES PARCO  (nomeParco)<br><br>\nDISPONIBILE (CALENDARIO_data, CALENDARIO_oraInizio, CALENDARIO_oraFine)  REFERENCES CALENDARIO  (data, oraInizio, oraFine)<br><br>DISPONIBILE (GUIDA_numTesserino)  REFERENCES GUIDA  (numTesserino)<br><br>\nGESTIONE (PARCO_nomeParco)  REFERENCES PARCO  (nomeParco)<br><br>GESTIONE (ENTE_nomeEnte)  REFERENCES ENTE  (nomeEnte)<br><br>\nRISERVARE (STRUTTURA_RICETTIVA_Via, STRUTTURA_RICETTIVA_numCivico, STRUTTURA_RICETTIVA_CAP)  REFERENCES STRUTTURA_RICETTIVA  (Via, numCivico, CAP)<br><br>RISERVARE (PERSONA_COD_fiscale)  REFERENCES PERSONA  (COD_fiscale)<br><br>\nINCLUDE (TRAGITTI_nomeTragitto)  REFERENCES TRAGITTI  (nomeTragitto)<br><br>INCLUDE (TOUR_nomeTour)  REFERENCES TOUR  (nomeTour)<br><br>\nVISITA (PARCO_nomeParco)  REFERENCES PARCO  (nomeParco)<br><br>VISITA (PERSONA_COD_fiscale)  REFERENCES PERSONA  (COD_fiscale)<br><br>\nPRENOTA (TOUR_nomeTour)  REFERENCES TOUR  (nomeTour)<br><br>PRENOTA (UTENTE_username)  REFERENCES UTENTE  (username)<br><br>\nASSEGNATA_A (GUIDA_numTesserino)  REFERENCES GUIDA  (numTesserino)<br><br>ASSEGNATA_A (TOUR_nomeTour)  REFERENCES TOUR  (nomeTour)<br><br>\nSVOLGE (GUIDA_numTesserino)  REFERENCES GUIDA  (numTesserino)<br><br>SVOLGE (TRAGITTI_nomeTragitto)  REFERENCES TRAGITTI  (nomeTragitto)<br><br>\nSI_RIVOLGE_A (PERSONA_COD_fiscale)  REFERENCES PERSONA  (COD_fiscale)<br><br>SI_RIVOLGE_A (CENTRO_VISITA_nomeCentro)  REFERENCES CENTRO_VISITA  (nomeCentro)<br><br>\nSI_RIFERISCE_A (PARCO_nomeParco)  REFERENCES PARCO  (nomeParco)<br><br>SI_RIFERISCE_A (CENTRO_VISITA_nomeCentro)  REFERENCES CENTRO_VISITA  (nomeCentro)<br><br>\nRELATIVO_A (GUIDA_numTesserino)  REFERENCES GUIDA  (numTesserino)<br><br>RELATIVO_A (FEEDBACK_TRAGITTI_nomeTragitto, FEEDBACK_data, FEEDBACK_ora)  REFERENCES FEEDBACK  (TRAGITTI_nomeTragitto, data, ora)<br><br>"},"edited":true,"sceneResetToken":1764153282308,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":null,"showNotesDataMenu":false}