IEDI\nentity BICI\nentity CAVALLO\nentity PERSONA {\n    COD_fiscale (id),\n    nome,\n    cognome,\n    dataNascita\n}\nentity TOUR {\n    nomeTour (id),\n    maxPartecipanti,\n    stato,\n    data,\n    ora\n}\nentity SENIOR\nentity BAMBINO\nentity GRUPPO {\n    tipo,\n    nomeGruppo (id),\n    classe (optional)\n}\nentity FEEDBACK {\n    data (external),\n    valutazione,\n    ora (external),\n    commento,\n    tipo\n}\nentity ZONE_UMIDE\nentity TERRESTRI_E_MARINE\nentity RISERVA\nentity NATURALE\nentity GUIDA {\n    numTesserino (id),\n    voto,\n    licenza,\n    campo\n}\nentity CALENDARIO {\n    data (id),\n    oraInizio (id),\n    oraFine (id),\n    note\n}\nentity UTENTE {\n    username (id),\n    password,\n    email,\n    telefono\n}\nentity CENTRO_VISITA {\n    nomeCentro (id),\n    indirizzo {\n        via,\n        CAP,\n        numCivico\n    },\n    orarioApertura,\n    contatti {\n        telefono,\n        email\n    },\n    servizi,\n    note,\n    orarioChiusura\n}\nentity NEWS {\n    data (id),\n    titolo (id),\n    autore,\n    testo,\n    foto\n}\n\n/* Relationships */\nrelationship GESTIONE (\n    PARCO: one..many,\n    ENTE: one..many\n)\nrelationship RISERVARE (\n    PERSONA: zero..many,\n    STRUTTURA_RICETTIVA: zero..many\n) {\n    dataPrenotazione,\n    numStanze,\n    stato\n}\nrelationship INCLUDE (\n    TOUR: one..many,\n    TRAGITTI: zero..many\n)\nrelationship VISITA (\n    PARCO: zero..many,\n    PERSONA: zero..many\n) {\n    data,\n    oraEntrata,\n    oraUscita\n}\nrelationship APPARTIENE_A (\n    PERSONA: zero..one,\n    GRUPPO: zero..many\n)\nrelationship ESPRIME (\n    FEEDBACK: one..one,\n    UTENTE: zero..many\n) {\n    anonimo\n}\nrelationship RIGUARDO (\n    FEEDBACK: one..one external,\n    TRAGITTI: zero..many\n)\nrelationship PRENOTA (\n    TOUR: zero..many,\n    UTENTE: zero..many\n) {\n    orario,\n    giorniDisponibili,\n    disponibile,\n    stato,\n    data\n}\nrelationship ASSEGNATA_A (\n    TOUR: one..many,\n    GUIDA: zero..many\n)\nrelationship SVOLGE (\n    GUIDA: one..many,\n    TRAGITTI: one..many\n)\nrelationship DISPONIBILE (\n    CALENDARIO: one..many,\n    GUIDA: one..many\n)\nrelationship SI_REGISTRA (\n    UTENTE: one..one,\n    PERSONA: zero..one\n)\nrelationship SI_RIVOLGE_A (\n    CENTRO_VISITA: one..many,\n    PERSONA: zero..many\n)\nrelationship SI_RIFERISCE_A (\n    CENTRO_VISITA: one..many,\n    PARCO: one..many\n)\nrelationship RELATIVO_A (\n    FEEDBACK: one..many,\n    GUIDA: one..many\n)\nrelationship POSSIEDE (\n    PARCO: one..many,\n    NEWS: one..one\n)\n\n/* Generalizations */\nTRAGITTI <= {\n    CAVALLO,\n    PIEDI,\n    BICI\n} (total, exclusive)\nPERSONA <= {\n    SENIOR,\n    BAMBINO\n} (partial, exclusive)\nPARCO <= {\n    NATURALE,\n    RISERVA,\n    ZONE_UMIDE,\n    TERRESTRI_E_MARINE\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Table","_id":243,"_name":"CALENDARIO","_x":-3049,"_y":-103,"_mag":false},{"__type":"Column","_id":245,"_name":"data","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":243,"_tableIndex":0},{"__type":"Column","_id":246,"_name":"oraInizio","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":243,"_tableIndex":1},{"__type":"Column","_id":247,"_name":"oraFine","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":243,"_tableIndex":2},{"__type":"Column","_id":248,"_name":"note","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":243,"_tableIndex":3},{"__type":"Table","_id":249,"_name":"GUIDA","_x":-2392,"_y":-106,"_mag":false},{"__type":"Column","_id":254,"_name":"numTesserino","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":249,"_tableIndex":0},{"__type":"Column","_id":255,"_name":"voto","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":249,"_tableIndex":1},{"__type":"Column","_id":256,"_name":"licenza","_type":"integ